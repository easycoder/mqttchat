# MQTT credentials — never commit these.
# The service reads `credentials` (or MQTTCHAT_CREDENTIALS); the local development
# client reads `mqttchat-credentials.json` from this directory.
credentials
mqttchat-credentials.json
*.eclecity.net.txt

# The access token that gates the service.
token

# Deployment target details
deploy.conf

# This deployment's own notes, and the write-up before it is published. They name the broker,
# the LAN and the hosting layout, so they belong to the deployment rather than to the code.
conversation/
DIFF.md
ARTICLE-DRAFT.md

# One-off probes for this machine's services (allspeak, rbrchat), not part of the app.
apps.sh
survey_apps.sh
stop_apps.sh

# A downloaded snapshot of the AllSpeak dev environment (allspeak.ai/code). The files this
# project needs from it are already in the tree.
allspeak-en.zip

# Python
__pycache__/
*.pyc

# Tool state
.reasonix/

# The AllSpeak dev environment's own version marker (server.allspeak rewrites it when it
# updates itself); local state, not part of the app.
.code-version
